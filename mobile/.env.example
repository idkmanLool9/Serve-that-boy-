# Mobile app configuration.
# These have working defaults baked into app.config.js, so the app runs without
# a .env file. Override here only if you point at your own Supabase project.

# Supabase project URL and publishable/anon key.
# The anon key is safe to ship publicly — Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://jvxbbpzmmnrtcbmerfla.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base path for the web build. Use "/" for local dev or a custom domain, and
# "/<repo-name>" when hosting under a GitHub Pages project subdirectory.
# (The deploy workflow sets this automatically from the repo name.)
# EXPO_BASE_URL=/serve-that-boy-
