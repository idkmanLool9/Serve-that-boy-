# Server
PORT=4000

# Database (SQLite by default — zero setup)
DATABASE_URL="file:./dev.db"

# Auth — CHANGE THIS to a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="30d"

# Comma-separated list of allowed origins for CORS ("*" allows all)
CORS_ORIGIN="*"
